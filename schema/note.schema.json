{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-bridge-template/note",
  "title": "Handoff note front matter (inbox-*/<date>-<ID>.md)",
  "type": "object",
  "required": ["from", "to", "task", "status", "verified", "unverified", "next_step"],
  "additionalProperties": false,
  "properties": {
    "from": {"type": "string", "enum": ["Lead", "Partner", "Owner", "automation"]},
    "to": {"type": "string", "enum": ["Lead", "Partner"]},
    "task": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,47}$"},
    "status": {"type": "string", "enum": ["open", "claimed", "in-progress", "blocked", "needs-owner", "review", "done"]},
    "verified": {"type": "string", "minLength": 1, "description": "what was checked, and how"},
    "unverified": {"type": "string", "minLength": 1, "description": "what was not checked; '-' if nothing"},
    "next_step": {"type": "string", "minLength": 1}
  }
}
